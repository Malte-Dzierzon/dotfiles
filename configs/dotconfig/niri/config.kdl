// Window-Animationen: schnell + smooth (expo/cubic, straffe Springs, kein Overshoot).
// explodes in varied patterns. Screen has a light orange flash for
// *dramatic effect* - inspired by C&C Red Alert

// This was a nightmare to make but here
// original code from; https://github.com/XansiVA
// Fixed: use raw strings (r"...") for GLSL shaders to match all other
// animations, and replaced ternary int-to-float cast with mix/step to
// avoid "implicit cast from int to float" (GL error C7011) on strict
// GLSL drivers, which caused the shader to silently fail to compile.

//Original written by; https://github.com/XansiVA

//Original code; https://github/XansiVA

animations {
    window-open {
        duration-ms 220
        curve "ease-out-expo"
    }
    window-close {
        duration-ms 180
        curve "ease-out-quad"
    }
    window-resize {
        duration-ms 200
        curve "ease-out-quad"
    }
    workspace-switch {
        duration-ms 250
        curve "ease-out-expo"
    }
    window-movement {
        duration-ms 250
        curve "ease-out-expo"
    }
    overview-open-close {
        duration-ms 300
        curve "ease-out-expo"
    }
}

// Startup Applications
spawn-at-startup "noctalia"
spawn-at-startup "walker --gapplication-service"
// Xwayland für Tk/X11-Apps (OrpheusDL-GUI) — DISPLAY=:0
spawn-at-startup "sh -c 'DISPLAY=:0 xwayland-satellite'"


overview {
    // Wallpaper im Overview via noctalia-wallpaper-Layer (place-within-backdrop).
    // backdrop transparent, damit der Layer durchscheint.
    backdrop-color "transparent"
    workspace-shadow {
        off
    }
}
layer-rule {
    match namespace="^noctalia-backdrop"
    place-within-backdrop true
}
layer-rule {
    match namespace="^noctalia-wallpaper$"
    place-within-backdrop true
}
gestures {
    hot-corners {
        off

        top-right
    }
}
// xwayland-satellite startet niri bei X11-Bedarf selbst — manueller Spawn war doppelt (~2 Prozesse).

// General Settings
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"
prefer-no-csd
environment {
    // NOTE: kein XDG_DATA_DIRS-Override — NixOS/HM setzen das korrekt pro Generation.
    QT_QPA_PLATFORMTHEME "qt6ct"
    QT_QPA_PLATFORM "wayland"
}

// Input Configuration
input {
    keyboard {
        xkb {
            layout "de"
        }
        numlock
    }

    touchpad {
        tap
        natural-scroll

        accel-profile "adaptive"
    }

    mouse {
        accel-speed -0.6
        accel-profile "flat"
    }
    // Cursor folgt Fokus (Warp): springt zu neu fokussierten Fenstern.
    warp-mouse-to-focus
    focus-follows-mouse
    trackpoint
}

hotkey-overlay {
    skip-at-startup
}

// Layout & Appearance: gaps 6, Blur sparsam (1 Pass), Schatten aus, Ecken eckig (Radius 0).
layout {
    gaps 6
    center-focused-column "never"
    background-color "transparent"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }

    focus-ring {
        width 1
        active-color "#8a8a8a"
        inactive-color "#3d3d3d"
    }

    border {
        off
    }
    shadow {
        off
    }
}

// Blur sparsam (niri 26.04+): 1 Pass reicht auf der iGPU, Defaults für Rest (kein Extra-Shader).
blur {
    passes 1
    offset 2.0
}
// Window Rules: Passwortschutz + leicht transparente Fenster mit Blur dahinter.
// (xray true = Wallpaper scheint geblurrt durch; Opacity 0.88.)
window-rule {
    match app-id=r"^float-term$"
    open-floating true
    default-column-width { proportion 0.55; }
    default-window-height { proportion 0.6; }
}

window-rule {
    match app-id=r"^org\.keepassxc\.KeePassXC$"
    match app-id=r"^org\.gnome\.World\.Secrets$"
    block-out-from "screen-capture"
}

window-rule {
    opacity 0.88
    draw-border-with-background false
    background-effect {
        blur true
        xray true
    }
}

// Noctalia-Surfaces: Blur ohne Xray (Bar, Panels, Notifications, OSD, Switcher).
layer-rule {
    match namespace="^noctalia-(bar-[^\"]+|notification|dock|panel|attached-panel|osd)$"
    background-effect {
        blur true
        xray false
    }
}
layer-rule {
    match namespace="noctalia-window-switcher"
    background-effect {
        blur true
        xray false
    }
}
// Walker-Launcher: kein Blur.
// Hinweis: CSD deaktiviert per `prefer-no-csd` oben.
// Niri selbst zeichnet nie Titelleisten, nur focus-ring/border.
// Keine Rundung: eckige Fenster erzwingen.
// libadwaita/GTK4 (Nautilus & Co.) zeichnen ihre Headerbar immer selbst.

// Ecken eckig (Radius 0), kein Clip-Schatten-Abschnitt mehr.
window-rule {
    geometry-corner-radius 0
    clip-to-geometry true
}
// Keybindings
binds {
    // Launcher & Menüs (Omarchy-Stil: Space = Launcher)
    Mod+Space hotkey-overlay-title="Launcher: noctalia" { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    Mod+Alt+Space hotkey-overlay-title="Control Center: Home" { spawn "noctalia" "msg" "panel-toggle" "control-center" "home"; }
    Mod+D hotkey-overlay-title="Launcher: walker" { spawn "walker"; }
    // Utilmenu entfernt (Skript nicht im Repo) — noctalia-launcher via Mod+Space.
    Mod+A hotkey-overlay-title="omp agent" { spawn "foot" "-a" "tui-omp" "-T" "omp" "omp"; }
    Mod+X { spawn "noctalia" "msg" "panel-toggle" "wallpaper"; }
    Mod+Escape { spawn "noctalia" "msg" "panel-toggle" "session"; }
    Mod+Shift+Slash { show-hotkey-overlay; }

    // Apps (Omarchy-Defaults, Terminal: foot, Browser: zen, Editor: zed)
    Mod+Return hotkey-overlay-title="Terminal" { spawn "foot"; }
    Mod+Alt+Return hotkey-overlay-title="Terminal tmux" { spawn "foot" "bash" "-c" "tmux attach || tmux new -s Work"; }
    Mod+E hotkey-overlay-title="Editor" { spawn "zeditor"; }
    Mod+N hotkey-overlay-title="NixOS-Config in zed" { spawn "foot" "bash" "-c" "SUDO_EDITOR='zeditor --wait' sudoedit /etc/nixos/configuration.nix"; }
    Mod+Shift+Return hotkey-overlay-title="Browser" { spawn "zen"; }
    Mod+Shift+B hotkey-overlay-title="Browser" { spawn "zen"; }
    Mod+Shift+Alt+B hotkey-overlay-title="Browser privat" { spawn "zen" "--private-window"; }
    Mod+Shift+F hotkey-overlay-title="Dateimanager" { spawn "nautilus" "--new-window"; }
    Mod+Alt+Shift+F hotkey-overlay-title="Dateimanager" { spawn "nautilus" "--new-window"; }
    Mod+Shift+D hotkey-overlay-title="Docker" { spawn-sh "foot lazydocker || foot docker ps"; }
    Mod+Shift+O hotkey-overlay-title="Obsidian" { spawn-sh "obsidian || xdg-open obsidian:// 2>/dev/null || notify-send 'Obsidian nicht installiert'"; }
    Mod+Ctrl+T hotkey-overlay-title="Systemmonitor" { spawn "foot" "btop"; }

    // Portiert aus Arch/Omarchy (config-data/hypr/bindings.conf) — Browser: zen
    Mod+Shift+C hotkey-overlay-title="ChatGPT" { spawn "zen" "--new-window" "https://chatgpt.com"; }
    Mod+Shift+Y hotkey-overlay-title="YouTube" { spawn "zen" "--new-window" "https://youtube.com/"; }
    Mod+Shift+W hotkey-overlay-title="WhatsApp" { spawn "zen" "--new-window" "https://web.whatsapp.com/"; }
    Mod+Shift+P hotkey-overlay-title="Google Photos" { spawn "zen" "--new-window" "https://photos.google.com/"; }
    Mod+Alt+M hotkey-overlay-title="Musik-TUI" { spawn "foot" "kew"; }
    Mod+Ctrl+Space { spawn "noctalia" "msg" "panel-toggle" "wallpaper"; }
    Mod+Ctrl+Shift+Space hotkey-overlay-title="Theme Switcher" { spawn "noctalia" "msg" "panel-toggle" "theblackdon/theme-switcher:carousel"; }

    // Fenster schließen (Omarchy: W und Q)
    Mod+W repeat=false { close-window; }
    Mod+Q repeat=false { close-window; }
    Super+Alt+L hotkey-overlay-title="Lock Screen" { spawn "swaylock"; }

    // Hardware Controls
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1+ -l 1.0"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1-"; }
    XF86AudioMute allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }

    XF86AudioPlay allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioStop allow-when-locked=true { spawn-sh "playerctl stop"; }
    XF86AudioPrev allow-when-locked=true { spawn-sh "playerctl previous"; }
    XF86AudioNext allow-when-locked=true { spawn-sh "playerctl next"; }

    XF86MonBrightnessUp allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "+10%"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "10%-"; }

    // Navigation & Window Movement
    Mod+O repeat=false { toggle-overview; }

    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }
    Mod+H     { focus-column-left; }
    Mod+J     { focus-window-down; }
    Mod+K     { focus-window-up; }
    Mod+L     { focus-column-right; }

    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Down  { move-window-down; }
    Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+H     { move-column-left; }
    Mod+Ctrl+J     { move-window-down; }
    Mod+Ctrl+K     { move-window-up; }
    Mod+Ctrl+L     { move-column-right; }

    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }
    Mod+Ctrl+Home { move-column-to-first; }
    Mod+Ctrl+End  { move-column-to-last; }

    Mod+Shift+Left  { focus-monitor-left; }
    Mod+Shift+Down  { focus-monitor-down; }
    Mod+Shift+Up    { focus-monitor-up; }
    Mod+Shift+Right { focus-monitor-right; }
    Mod+Shift+H     { focus-monitor-left; }
    Mod+Shift+J     { focus-monitor-down; }
    Mod+Shift+K     { focus-monitor-up; }
    Mod+Shift+L     { focus-monitor-right; }

    Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Down  { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+Up    { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+H     { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+J     { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+K     { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+L     { move-column-to-monitor-right; }

    // Workspaces
    Mod+Page_Down      { focus-workspace-down; }
    Mod+Page_Up        { focus-workspace-up; }
    Mod+U              { focus-workspace-down; }
    Mod+I              { focus-workspace-up; }
    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up   { move-column-to-workspace-up; }
    Mod+Ctrl+U         { move-column-to-workspace-down; }
    Mod+Ctrl+I         { move-column-to-workspace-up; }
    Mod+Tab repeat=false { focus-workspace-down; }
    Mod+Shift+Tab repeat=false { focus-workspace-up; }

    Mod+Shift+Page_Down { move-workspace-down; }
    Mod+Shift+Page_Up   { move-workspace-up; }
    Mod+Shift+U         { move-workspace-down; }
    Mod+Shift+I         { move-workspace-up; }

    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp cooldown-ms=150 { move-column-to-workspace-up; }

    Mod+WheelScrollRight      { focus-column-right; }
    Mod+WheelScrollLeft       { focus-column-left; }
    Mod+Ctrl+WheelScrollRight { move-column-right; }
    Mod+Ctrl+WheelScrollLeft  { move-column-left; }

    Mod+Shift+WheelScrollDown      { focus-column-right; }
    Mod+Shift+WheelScrollUp        { focus-column-left; }
    Mod+Ctrl+Shift+WheelScrollDown { move-column-right; }
    Mod+Ctrl+Shift+WheelScrollUp   { move-column-left; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }

    // Layout Controls
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+Comma  { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }

    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-window-height; }
    Mod+Ctrl+R { reset-window-height; }
    Mod+F { fullscreen-window; }
    Mod+Shift+M { maximize-column; }
    Mod+Ctrl+F { expand-column-to-available-width; }
    Mod+C { center-column; }
    Mod+Ctrl+C { center-visible-columns; }

    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    Mod+T { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }
    Mod+Alt+W { toggle-column-tabbed-display; }

    // Utilities & System
    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }

    Mod+Shift+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    Mod+Shift+E { quit; }
    Ctrl+Alt+Delete { quit; }
    Mod+Alt+P { power-off-monitors; }
}



include "noctalia.kdl"
