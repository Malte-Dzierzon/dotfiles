        {
          "name": "muse-spark-1.2-contributor-free",
          "display_name": "Muse Spark 1.2 (free)",
          "max_tokens": 1048576,
          "max_output_tokens": 131072,
          "protocol": "openai_chat",
          "reasoning_effort_levels": [
            "low",
            "medium",
