          ],
          "interleaved_reasoning": true
        },
        {
          "name": "nemotron-3-ultra-free",
          "display_name": "Nemotron 3 Ultra (free)",
          "max_tokens": 1000000,
          "max_output_tokens": 128000,
          "protocol": "openai_chat",
          "reasoning_effort_levels": [
