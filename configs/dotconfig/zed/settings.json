          ],
          "interleaved_reasoning": true
        },
        {
          "name": "muse-spark-1.3-contributor-free",
          "display_name": "Muse Spark 1.3 (free)",
          "max_tokens": 1048576,
          "max_output_tokens": 131072,
          "protocol": "openai_chat",
          "reasoning_effort_levels": [
            "low",
            "medium",
            "high",
