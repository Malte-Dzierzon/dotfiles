{
  "project_panel": {
    "dock": "right"
  },
  "outline_panel": {
    "dock": "right"
  },
  "collaboration_panel": {
    "dock": "right"
  },
  "git_panel": {
    "dock": "right"
  },
  "base_keymap": "JetBrains",
  "rounded_selection": true,
  "window_decorations": "server",
  "use_smartcase_search": true,
  "search": {
    "case_sensitive": false,
    "whole_word": true
  },
  "diagnostics": {
    "inline": {
      "enabled": true
    }
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false
  },
  "use_system_path_prompts": true,
  "vim_mode": false,
  "cli_default_open_behavior": "existing_window",
  "active_pane_modifiers": {
    "inactive_opacity": 0.9
  },
  "agent_ui_font_size": 17,
  "ui_font_size": 17,
  "buffer_font_size": 17,
  "buffer_font_weight": 400,
  "agent": {
    "dock": "left",
    "show_turn_stats": true,
    "enable_feedback": false,
    "sandbox_permissions": {
      "allow_unsandboxed": true
    },
    "default_model": {
      "effort": "xhigh",
      "provider": "opencode",
      "model": "zen/muse-spark-1.3-contributor-free",
      "enable_thinking": false
    },
    "play_sound_when_agent_done": "always",
    "tool_permissions": {
      "default": "allow"
    },
    "sidebar_side": "right",
    "favorite_models": [
      {
        "provider": "lmstudio",
        "model": "qwen3.6-27b-omnimerge-v4-mtp",
        "enable_thinking": false
      },
      {
        "provider": "openai-subscribed",
        "model": "gpt-5.4",
        "enable_thinking": true,
        "effort": "medium"
      },
      {
        "provider": "lmstudio",
        "model": "prism-ml/bonsai-27b",
        "enable_thinking": false
      },
      {
        "provider": "opencode",
        "model": "zen/muse-spark-1.3-contributor-free",
        "enable_thinking": false
      },
      {
        "provider": "opencode",
        "model": "zen/nemotron-3-ultra-free",
        "enable_thinking": true,
        "effort": "high"
      },
      {
        "provider": "opencode",
        "model": "zen/big-pickle",
        "enable_thinking": false,
        "effort": "low"
      },
      {
        "provider": "opencode",
        "model": "zen/mimo-v2.5-free",
        "enable_thinking": false
      },
      {
        "provider": "opencode",
        "model": "zen/ling-3.0-flash-fin-free",
        "enable_thinking": false
      },
      {
        "provider": "opencode",
        "model": "zen/nemotron-3.5-lightning-free",
        "enable_thinking": false
      },
      {
        "provider": "opencode",
        "model": "zen/muse-spark-1.2-contributor-free",
        "enable_thinking": false
      }
    ]
  },
  "agent_servers": {
    "pi-acp": {
      "type": "registry"
    },
    "Oh My Pi": {
      "type": "custom",
      "command": "omp",
      "args": [
        "acp"
      ]
    },
    "opencode": {
      "default_config_options": {
        "effort": "xhigh",
        "model": "opencode/muse-spark-1.3-contributor-free"
      },
      "favorite_config_option_values": {
        "model": [
          "opencode/big-pickle",
          "opencode/ling-3.0-flash-fin-free",
          "opencode/mimo-v2.5-free",
          "opencode/muse-spark-1.2-contributor-free",
          "opencode/muse-spark-1.3-contributor-free",
          "opencode/nemotron-3-ultra-free",
          "opencode/nemotron-3.5-lightning-free"
        ]
      },
      "type": "registry"
    }
  },
  "language_models": {
    "opencode": {
      "show_zen_models": true,
      "show_go_models": false,
      "available_models": [
        {
          "name": "big-pickle",
          "display_name": "Big Pickle (free)",
          "max_tokens": 200000,
          "max_output_tokens": 32000,
          "protocol": "openai_chat",
          "reasoning_effort_levels": [
            "low",
            "medium",
            "high",
            "xhigh"
          ],
          "interleaved_reasoning": true
        },
        {
