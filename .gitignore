# Generiert: Noctalia schreibt diese Dateien bei jedem Theme-/Wallpaper-
# Wechsel neu. Sie liegen im Repo als Startpunkt, lokale Aenderungen
# durch Noctalia erscheinen als git-diff (bewusst, kein ignore).
# Echte Secrets / Host-spezifisches:
# Backups & Caches
*.bak-*
*~
.cache/
home/.cache/
# Hardware ist host-spezifisch (nur .example aktuell halten)
hosts/nixos/hardware-configuration.nix
# Lokale Binary-Builds (kein Source im Repo, je Rechner neu bauen/laden)
home/.local/bin/omp
home/.local/bin/zapfast-real
home/.local/bin/cliamp-real
home/.local/bin/zed
