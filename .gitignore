# Generiert: Noctalia schreibt diese Dateien bei jedem Theme-/Wallpaper-
# Wechsel neu. Sie liegen im Repo als Startpunkt, lokale Aenderungen
# durch Noctalia erscheinen als git-diff (bewusst, kein ignore).
# Echte Secrets / Host-spezifisches:
# Backups & Caches
*.bak-*
*~
.cache/
home/.cache/
# Hardware ist host-spezifisch (nur .example aktuell halten)
hosts/nixos/hardware-configuration.nix
# Installer-Auswahl pro Maschine (nur .example versionieren)
hosts/nixos/local.nix
# Lokale Binary-Builds (kein Source im Repo, je Rechner neu bauen/laden)
home/.local/bin/zapfast-real
home/.local/bin/zed
home/.local/bin/pakmc-bin
home/.local/bin/moviebox-tui
home/.local/bin/tldraw.AppImage
home/.local/bin/noctalia
# Wallpapers sind gross (66MB) — lokal unter ~/Pictures/Wallpapers halten,
# nicht im Repo. Nur Vorschau-Bilder in Pictures/preview/.
Pictures/Wallpapers/
Pictures/*.png
!Pictures/preview/
# mpd Laufzeit (kein Config, wird vom Daemon geschrieben)
configs/dotconfig/mpd/database
configs/dotconfig/mpd/log
configs/dotconfig/mpd/pid
configs/dotconfig/mpd/state
configs/dotconfig/mpd/sticker.sql
configs/dotconfig/cliamp/cliamp.sock
configs/dotconfig/cliamp/cliamp.sock.pid
configs/dotconfig/cliamp/cliamp.log

# Installer backups + build outputs
*.pre-dotfiles
result
# opencode service.json enthaelt ein Klartext-Passwort (Laufzeit-State, kein Source)
configs/dotconfig/opencode/service.json
