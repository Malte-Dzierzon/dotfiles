{
  "$schema": "https://opencode.ai/theme.json",
  "base": {
    "categorical": ["accent", "cyan", "purple", "blue"],
    "text": {
      "base": "$hue.neutral.100",
      "muted": "$hue.neutral.300",
      "action": {
        "primary": {
          "base": "$hue.interactive.200", "$hovered": "$hue.interactive.100",
          "$focused": "$hue.interactive.100", "$pressed": "$hue.interactive.300",
          "$selected": "$hue.interactive.200", "$disabled": "$text.muted"
        },
        "secondary": {"base": "$text.muted", "$hovered": "$text.base"},
        "destructive": {"base": "$hue.red.200", "$disabled": "$text.muted"}
      },
      "formfield": {
        "base": "$hue.neutral.100", "$hovered": "$hue.interactive.100",
        "$focused": "$hue.interactive.100", "$pressed": "$hue.interactive.200",
        "$selected": "$hue.interactive.100", "$disabled": "$text.muted"
      },
      "feedback": {
        "error":   {"base": "$hue.red.200",    "muted": "$hue.red.400"},
        "warning": {"base": "$hue.yellow.200", "muted": "$hue.yellow.400"},
        "success": {"base": "$hue.green.200",  "muted": "$hue.green.400"},
        "info":    {"base": "$hue.cyan.300",   "muted": "$hue.cyan.400"}
      }
    },
    "background": {
      "base": "$hue.neutral.800",
      "raised": {"base": "$hue.neutral.700", "high": "$hue.neutral.600", "max": "$hue.neutral.500"},
      "action": {
        "primary": {
          "base": "transparent", "$hovered": "$background.raised.high",
          "$focused": "$hue.interactive.200", "$selected": "transparent"
        },
        "secondary": {"base": "transparent"},
        "destructive": {"base": "$hue.red.200"}
      },
      "formfield": {"base": "$background.base"},
      "feedback": {
        "error": {"base": "$background.base"}, "warning": {"base": "$background.base"},
        "success": {"base": "$background.base"}, "info": {"base": "$background.base"}
      }
    },
    "border": {"base": "$hue.neutral.600"},
    "scrollbar": {"base": "$hue.neutral.400"},
    "diff": {
      "text": {"added": "$hue.green.200", "removed": "$hue.red.200",
               "context": "$hue.neutral.300", "hunkHeader": "$hue.cyan.200"},
      "background": {"added": "$hue.green.900", "removed": "$hue.red.900",
                     "context": "$hue.neutral.800"},
      "highlight": {"added": "$hue.green.700", "removed": "$hue.red.700"},
      "lineNumber": {"text": "$hue.neutral.400",
                     "background": {"added": "$hue.green.800", "removed": "$hue.red.800"}}
    },
    "syntax": {
      "comment": "$hue.neutral.400", "keyword": "$hue.blue.200",
      "function": "$hue.cyan.200", "variable": "$hue.neutral.100",
      "string": "$hue.purple.200", "number": "$hue.purple.300",
      "type": "$hue.cyan.300", "operator": "$hue.neutral.300",
      "punctuation": "$hue.neutral.400"
    },
    "markdown": {
      "text": "$hue.neutral.100", "heading": "$hue.cyan.200",
      "link": "$hue.blue.200", "linkText": "$hue.cyan.200",
      "code": "$hue.purple.200", "blockQuote": "$hue.neutral.300",
      "emphasis": "$hue.blue.300", "strong": "$hue.cyan.200",
      "horizontalRule": "$hue.neutral.500", "listItem": "$hue.cyan.200",
      "listEnumeration": "$hue.blue.300", "image": "$hue.purple.200",
      "imageText": "$hue.blue.200", "codeBlock": "$hue.neutral.100"
    },
    "@dialog": {"background": {"base": "$background.raised.base",
                                "action": {"primary": {"$hovered": "$background.raised.high"}}}}
  },
  "dark": {
    "hue": {
      "gray": {
        "100": "{{ colors.on_surface.dark.hex }}",
        "200": "{{ colors.on_surface_variant.dark.hex }}",
        "300": "{{ colors.on_surface_variant.dark.hex | darken 10 }}",
        "400": "{{ colors.outline.dark.hex }}",
        "500": "{{ colors.outline.dark.hex | darken 12 }}",
        "600": "{{ colors.outline_variant.dark.hex }}",
        "700": "{{ colors.surface_container.dark.hex }}",
        "800": "{{ colors.surface.dark.hex }}",
        "900": "{{ colors.surface_container_lowest.dark.hex }}"
      },
      "red": {
        "100": "{{ colors.error.dark.hex | lighten 18 }}",
        "200": "{{ colors.error.dark.hex }}",
        "300": "{{ colors.error.dark.hex | darken 8 }}",
        "400": "{{ colors.error.dark.hex | darken 16 }}",
        "500": "{{ colors.error.dark.hex | darken 24 }}",
        "600": "{{ colors.error.dark.hex | darken 32 }}",
        "700": "{{ colors.error.dark.hex | darken 40 }}",
        "800": "{{ colors.error.dark.hex | darken 48 }}",
        "900": "{{ colors.error.dark.hex | darken 56 }}"
      },
      "orange": "$hue.red",
      "yellow": "$hue.purple",
      "green": "$hue.cyan",
      "cyan": {
        "100": "{{ colors.primary.dark.hex | lighten 18 }}",
        "200": "{{ colors.primary.dark.hex }}",
        "300": "{{ colors.primary.dark.hex | darken 8 }}",
        "400": "{{ colors.primary.dark.hex | darken 16 }}",
        "500": "{{ colors.primary.dark.hex | darken 24 }}",
        "600": "{{ colors.primary.dark.hex | darken 32 }}",
        "700": "{{ colors.primary.dark.hex | darken 40 }}",
        "800": "{{ colors.primary.dark.hex | darken 48 }}",
        "900": "{{ colors.primary.dark.hex | darken 56 }}"
      },
      "blue": {
        "100": "{{ colors.secondary.dark.hex | lighten 18 }}",
        "200": "{{ colors.secondary.dark.hex }}",
        "300": "{{ colors.secondary.dark.hex | darken 8 }}",
        "400": "{{ colors.secondary.dark.hex | darken 16 }}",
        "500": "{{ colors.secondary.dark.hex | darken 24 }}",
        "600": "{{ colors.secondary.dark.hex | darken 32 }}",
        "700": "{{ colors.secondary.dark.hex | darken 40 }}",
        "800": "{{ colors.secondary.dark.hex | darken 48 }}",
        "900": "{{ colors.secondary.dark.hex | darken 56 }}"
      },
      "purple": {
        "100": "{{ colors.tertiary.dark.hex | lighten 18 }}",
        "200": "{{ colors.tertiary.dark.hex }}",
        "300": "{{ colors.tertiary.dark.hex | darken 8 }}",
        "400": "{{ colors.tertiary.dark.hex | darken 16 }}",
        "500": "{{ colors.tertiary.dark.hex | darken 24 }}",
        "600": "{{ colors.tertiary.dark.hex | darken 32 }}",
        "700": "{{ colors.tertiary.dark.hex | darken 40 }}",
        "800": "{{ colors.tertiary.dark.hex | darken 48 }}",
        "900": "{{ colors.tertiary.dark.hex | darken 56 }}"
      },
      "accent": "$hue.cyan", "interactive": "$hue.cyan", "neutral": "$hue.gray"
    }
  },
  "light": {
    "hue": {
      "gray": {
        "100": "{{ colors.on_surface.light.hex }}",
        "200": "{{ colors.on_surface_variant.light.hex }}",
        "300": "{{ colors.outline.light.hex }}",
        "400": "{{ colors.outline.light.hex | lighten 10 }}",
        "500": "{{ colors.outline_variant.light.hex }}",
        "600": "{{ colors.outline_variant.light.hex | lighten 10 }}",
        "700": "{{ colors.surface_container_high.light.hex }}",
        "800": "{{ colors.surface.light.hex }}",
        "900": "{{ colors.surface_container_lowest.light.hex }}"
      },
      "red": {
        "100": "{{ colors.error.light.hex | darken 15 }}",
        "200": "{{ colors.error.light.hex }}",
        "300": "{{ colors.error.light.hex | lighten 10 }}",
        "400": "{{ colors.error.light.hex | lighten 18 }}",
        "500": "{{ colors.error.light.hex | lighten 26 }}",
        "600": "{{ colors.error.light.hex | lighten 34 }}",
        "700": "{{ colors.error.light.hex | lighten 42 }}",
        "800": "{{ colors.error.light.hex | lighten 50 }}",
        "900": "{{ colors.error.light.hex | lighten 58 }}"
      },
      "orange": "$hue.red",
      "yellow": "$hue.purple",
      "green": "$hue.cyan",
      "cyan": {
        "100": "{{ colors.primary.light.hex | darken 15 }}",
        "200": "{{ colors.primary.light.hex }}",
        "300": "{{ colors.primary.light.hex | lighten 10 }}",
        "400": "{{ colors.primary.light.hex | lighten 18 }}",
        "500": "{{ colors.primary.light.hex | lighten 26 }}",
        "600": "{{ colors.primary.light.hex | lighten 34 }}",
        "700": "{{ colors.primary.light.hex | lighten 42 }}",
        "800": "{{ colors.primary.light.hex | lighten 50 }}",
        "900": "{{ colors.primary.light.hex | lighten 58 }}"
      },
      "blue": {
        "100": "{{ colors.secondary.light.hex | darken 15 }}",
        "200": "{{ colors.secondary.light.hex }}",
        "300": "{{ colors.secondary.light.hex | lighten 10 }}",
        "400": "{{ colors.secondary.light.hex | lighten 18 }}",
        "500": "{{ colors.secondary.light.hex | lighten 26 }}",
        "600": "{{ colors.secondary.light.hex | lighten 34 }}",
        "700": "{{ colors.secondary.light.hex | lighten 42 }}",
        "800": "{{ colors.secondary.light.hex | lighten 50 }}",
        "900": "{{ colors.secondary.light.hex | lighten 58 }}"
      },
      "purple": {
        "100": "{{ colors.tertiary.light.hex | darken 15 }}",
        "200": "{{ colors.tertiary.light.hex }}",
        "300": "{{ colors.tertiary.light.hex | lighten 10 }}",
        "400": "{{ colors.tertiary.light.hex | lighten 18 }}",
        "500": "{{ colors.tertiary.light.hex | lighten 26 }}",
        "600": "{{ colors.tertiary.light.hex | lighten 34 }}",
        "700": "{{ colors.tertiary.light.hex | lighten 42 }}",
        "800": "{{ colors.tertiary.light.hex | lighten 50 }}",
        "900": "{{ colors.tertiary.light.hex | lighten 58 }}"
      },
      "accent": "$hue.cyan", "interactive": "$hue.cyan", "neutral": "$hue.gray"
    },
    "border": {
      "base": "$hue.neutral.500"
    }
  }
}
