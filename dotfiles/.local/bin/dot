#!/usr/bin/env bash
# dot — minimal NixOS control (this repo).
# Works from the checkout directly (scripts/dot) without global install;
# installed copy (dotfiles/.local/bin/dot) resolves through its own path.
# Commands: (none)=menu, ls, apps, check, apply, restore, help.
set -euo pipefail

SELF="$(readlink -f "$0")"
if [[ "$SELF" == */scripts/dot ]]; then REPO="$(cd "$(dirname "$SELF")/.." && pwd)"; else REPO="$(cd "$(dirname "$SELF")/../../.." && pwd)"; fi
# shellcheck source=ui.sh
source "$REPO/scripts/ui.sh"

dot_ls() {
  exec "$REPO/scripts/apps.sh" --list
}

dot_restore() {
  exec "$REPO/scripts/restore.sh" "$@"
}

help() {
  cat <<'EOF'
dot — NixOS control.

  dot            interactive menu (check/apply/apps/restore)
  dot ls         bundles: contents + enabled state
  dot apps       interactive bundle selector (saves, does not activate)
  dot check      read-only validation (no changes)
  dot apply      validate + build + confirm + activate
  dot restore    list + roll back system generations (not source files)
  dot help       this help

Helpers (kept, not core): default-app, mime, applist, mode, verify.
EOF
}

menu() {
  local opts=(check apply apps ls restore help) choice=""
  if command -v gum >/dev/null 2>&1 && { : </dev/tty; } 2>/dev/null; then
    choice="$(gum choose --header "dot — what next? (Esc aborts)" "${opts[@]}" </dev/tty 2>/dev/null)" || exit 0
  else
    echo "dot — what next? (0 aborts)" >&2
    select choice in "${opts[@]}"; do break; done < /dev/tty 2>/dev/null || { echo "no TTY — use: dot help"; exit 1; }
  fi
  [[ -z "$choice" ]] && exit 0
  case "$choice" in
    ls) dot_ls ;;
    restore) dot_restore "$@" ;;
    help) help ;;
    *) exec "$REPO/scripts/$choice.sh" ;;
  esac
}

cmd="${1:-menu}"
shift || true

case "$cmd" in
  menu) menu ;;
  ls) dot_ls ;;
  apps) exec "$REPO/scripts/apps.sh" "$@" ;;
  check) exec "$REPO/scripts/check.sh" "$@" ;;
  apply) exec "$REPO/scripts/apply.sh" "$@" ;;
  restore) dot_restore "$@" ;;
  applist) exec "$REPO/scripts/applist.sh" "$@" ;;
  mime) exec "$REPO/scripts/mime.sh" "$@" ;;
  default-app) exec "$REPO/dotfiles/.local/bin/default-app" "$@" ;;
  mode) exec "$REPO/scripts/mode.sh" "$@" ;;
  verify) exec "$REPO/scripts/verify.sh" "$@" ;;
  help | -h | --help) help ;;
  *) ui_err "unknown: $cmd"; help >&2; exit 1 ;;
esac
