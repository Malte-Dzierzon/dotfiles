#!/usr/bin/env bash
# lysec — global entry point for the NixOS setup (this repo).
# Installed via apply.sh symlink (~/.local/bin -> repo/home/.local/bin).
# Usage: lysec [apply|dry|verify|update|diff] [args...]
set -euo pipefail

# Resolve repo through the symlink (works from anywhere).
SELF="$(readlink -f "$0")"
REPO="$(cd "$(dirname "$SELF")/../../.." && pwd)"

cmd="${1:-apply}"
shift || true

summary() {
  # Compact change summary: what would / did change.
  echo "--- lysec summary ---"
  git -C "$REPO" log --oneline -3
  echo "--- local selection ---"
  grep -E '^\s+[a-zA-Z]+ =' "$REPO/hosts/nixos/local.nix" 2>/dev/null | grep -vE 'lysec = \{' || echo "(no local.nix)"
  echo "--- working tree ---"
  git -C "$REPO" status --short | head -8
}

case "$cmd" in
  apply)
    summary
    exec "$REPO/scripts/apply.sh" "$@"
    ;;
  dry)
    summary
    exec "$REPO/scripts/apply.sh" --dry-run "$@"
    ;;
  verify)
    exec "$REPO/scripts/verify.sh" "$@"
    ;;
  update)
    exec "$REPO/scripts/update.sh" "$@" && summary
    ;;
  diff)
    git -C "$REPO" diff --stat; git -C "$REPO" status --short | head -10
    ;;
  *)
    echo "Usage: lysec [apply|dry|verify|update|diff]" >&2
    exit 1
    ;;
esac
