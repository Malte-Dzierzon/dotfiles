[Desktop Entry]
Name=Qalculate!
GenericName=Taschenrechner (TUI)
Comment=Leistungsfähiger Taschenrechner im Terminal
Exec=/home/xealom/.nix-profile/bin/foot -a tui-qalc -T Qalculate /run/current-system/sw/bin/qalc
Icon=/home/xealom/.local/share/icons/tui-apps/qalc.png
Type=Application
Categories=Office;Calculator;ConsoleOnly;
Keywords=calc;calculator;qalculate;qalc;
StartupWMClass=tui-qalc
Terminal=false
